CAL_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxx
CAL_EVENT_TYPE_ID=
RESEND_API_KEY=
MAKE_GET_STARTED_WEBHOOK_URL=
MAKE_CHECKOUT_WEBHOOK_URL=
MAKE_REVENUE_LIFT_WEBHOOK_URL=
MAKE_WEBINAR_WEBHOOK_URL=

# Meta Conversions API (server-side Lead + Schedule, deduped with the browser Pixel)
# Events Manager -> Settings -> Conversions API -> Generate access token
META_CAPI_ACCESS_TOKEN=
# Optional: defaults to the site pixel 959022406709300 if unset
META_PIXEL_ID=
# Optional: Events Manager -> Test Events code. Set ONLY while testing, then remove.
META_TEST_EVENT_CODE=

# X/Twitter Pixel + Conversions API
# Ads Manager -> Tools -> Events Manager -> X Pixel. Pixel ID defaults to r8ftv if unset.
X_PIXEL_ID=
# Install Pixel -> Conversion API -> Generate access token. Keep server-side only.
X_PIXEL_TOKEN=
# Event IDs from X Events Manager event install code, e.g. tw-r8ftv-abc12.
X_AUDIT_LEAD_EVENT_ID=tw-r8ftv-r8ftx
X_AUDIT_CALL_BOOKED_EVENT_ID=tw-r8ftv-rd0hl
